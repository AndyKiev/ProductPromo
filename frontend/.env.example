# Origin of the API. The client appends /api/v1 itself (src/utils/eNums.ts,
# src/api/axiosInstance.ts), so do NOT include it here.
#
# Native dev (`make run-frontend`) talks to the native backend on 8004.
# The container gets http://127.0.0.1:8012 from docker-compose.yml instead —
# the browser runs on the host, so it needs the *published* port.
VITE_BACKEND_API_URL=http://127.0.0.1:8004
