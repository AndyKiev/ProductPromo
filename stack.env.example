# Copy to stack.env (gitignored) and fill in. Consumed by docker-compose -> backend.
# APP_CONFIG__DB__HOST/PORT and APP_CONFIG__RUN__* are overridden in
# docker-compose.yml — real env vars beat env_file values in pydantic-settings.

# --- Corporate proxy (ONLY if building images behind a proxy; else leave blank) ---
APP_HTTP_PROXY=
APP_HTTPS_PROXY=
APP_NO_PROXY=localhost,127.0.0.1,host.docker.internal

# --- Database (postgresql+asyncpg or mysql+aiomysql) ---
# The database is NOT in compose. It is the native host cluster on 5435;
# compose rewrites HOST to host.docker.internal. See docs/DB_MIGRATION.md.
APP_CONFIG__DB__DRIVER=postgresql+asyncpg
APP_CONFIG__DB__HOST=host.docker.internal
APP_CONFIG__DB__PORT=5435
APP_CONFIG__DB__USER=admin
APP_CONFIG__DB__PASSWORD=<see docs/DB_MIGRATION.md>
APP_CONFIG__DB__NAME=product_promo
APP_CONFIG__DB__ECHO=false

# --- Auth (single-user JWT) ---
AUTH_USER_CODE=UKR7101004
AUTH_USER_PASSWORD=111

# --- run ---
APP_CONFIG__RUN__HOST=0.0.0.0
APP_CONFIG__RUN__PORT=8004
