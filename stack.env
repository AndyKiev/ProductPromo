# Copy to stack.env (gitignored) and fill in. Consumed by docker-compose -> backend.

# --- Corporate proxy (ONLY if building images behind a proxy; else leave blank) ---
APP_HTTP_PROXY=
APP_HTTPS_PROXY=
APP_NO_PROXY=localhost,127.0.0.1,host.docker.internal

# --- Database (postgresql+asyncpg or mysql+aiomysql) ---
APP_CONFIG__DB__DRIVER=postgresql+asyncpg
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__USER=productpromo
APP_CONFIG__DB__PASSWORD=productpromo
APP_CONFIG__DB__NAME=productpromo
APP_CONFIG__DB__ECHO=false

# --- Auth (single-user JWT) ---
AUTH_USER_CODE=UKR7101004
AUTH_USER_PASSWORD=111

# --- run ---
APP_CONFIG__RUN__HOST=0.0.0.0
APP_CONFIG__RUN__PORT=8004
