# Copy to .env and fill in. All keys are prefixed APP_CONFIG__ with __ nesting.
# Used by native dev (`make run-backend`); the container reads stack.env.

# --- Auth (single-user JWT) ---
AUTH_USER_CODE=UKR7101004
AUTH_USER_PASSWORD=111

# --- run ---
APP_CONFIG__RUN__HOST=127.0.0.1
APP_CONFIG__RUN__PORT=8004
APP_CONFIG__RUN__RELOAD=true

# --- Database (postgresql+asyncpg or mysql+aiomysql) ---
# Native Windows PostgreSQL 18 cluster — see docs/DB_MIGRATION.md.
APP_CONFIG__DB__DRIVER=postgresql+asyncpg
APP_CONFIG__DB__HOST=127.0.0.1
APP_CONFIG__DB__PORT=5435
APP_CONFIG__DB__USER=admin
APP_CONFIG__DB__PASSWORD=<see docs/DB_MIGRATION.md>
APP_CONFIG__DB__NAME=product_promo
APP_CONFIG__DB__ECHO=false

# --- CORS (dev: open) ---
# APP_CONFIG__CORS__ORIGINS=["http://localhost:8009"]
